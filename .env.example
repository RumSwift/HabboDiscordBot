# Copy this file to .env and fill in the values. NEVER commit .env.
#
# Values containing special characters (# \ " ' $ or spaces) MUST be wrapped in
# single quotes, e.g. DB_PASSWORD='p@ss#word'. Without quotes, everything after
# a # is treated as a comment and silently removed.

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=HabboVerifyBotDEV

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=1558169893730525335

# Discord verification roles (one role ID per hotel; leave blank to skip role assignment for that hotel)
HABBO_ROLE_COM=
HABBO_ROLE_COM_BR=
HABBO_ROLE_ES=
HABBO_ROLE_FI=
HABBO_ROLE_FR=
HABBO_ROLE_DE=
HABBO_ROLE_IT=
HABBO_ROLE_NL=
HABBO_ROLE_COM_TR=

# Discord audit logging thread (ID of an EXISTING thread)
DISCORD_LOG_THREAD_ID=

# Force linked members' nicknames to "<HabboUsername> (<Hotel>)" and put them back if changed.
# The bot always needs the Server Members Intent (developer portal -> Bot -> Privileged Gateway Intents).
ENFORCE_NICKNAMES=true
# How often (seconds) every linked member's nickname is re-checked. Checks use the bot's member cache, so 60 is fine for large servers.
NICKNAME_SWEEP_INTERVAL_SECONDS=60

# Internal HTTP API
API_HOST=127.0.0.1
API_PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_KEY=

# Verification settings
VERIFICATION_CODE_PREFIX=DISC-
VERIFICATION_CODE_LENGTH=6
VERIFICATION_EXPIRY_MINUTES=5
VERIFICATION_MAX_ATTEMPTS=3
# Server-side secret used to HMAC verification codes before storing them (min 32 chars).
# Generate the same way as INTERNAL_API_KEY. Changing it invalidates in-flight challenges only.
VERIFICATION_CODE_SECRET=

# Habbo API settings
HABBO_API_TIMEOUT_MS=10000
HABBO_API_MAX_RETRIES=2

# Logging (debug, info, warn, error)
LOG_LEVEL=info
