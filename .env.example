# Copy this file to .env and fill in the values. NEVER commit .env.
#
# Values containing special characters (# \ " ' $ or spaces) MUST be wrapped in
# single quotes, e.g. DB_PASSWORD='p@ss#word'. Without quotes, everything after
# a # is treated as a comment and silently removed.

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
# Created on first start if it does not exist (needs CREATE permission; otherwise create it yourself).
DB_NAME=HabboVerifyBot

# Discord
DISCORD_TOKEN=
# Application ID (developer portal -> General Information)
DISCORD_CLIENT_ID=

# Nicknames: verified members can be forced to "<HabboUsername> (<Hotel>)". This is switched on or off per server
# on the admin page. This is how often (seconds) every linked member's nickname is re-checked in those servers.
NICKNAME_SWEEP_INTERVAL_SECONDS=60

# Internal HTTP API
API_HOST=127.0.0.1
API_PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_KEY=

# Admin page at http://API_HOST:API_PORT/admin/ for choosing servers, roles and log channels.
# At least 16 characters. Leave empty to switch the page off. Generate one the same way as INTERNAL_API_KEY.
# The page is served on API_HOST, which defaults to this machine only. To reach it from elsewhere, use an
# SSH tunnel (ssh -L 3000:127.0.0.1:3000 you@server) or put it behind an HTTPS reverse proxy; never plain HTTP.
ADMIN_PASSWORD=

# Verification settings
VERIFICATION_CODE_PREFIX=DISC-
VERIFICATION_CODE_LENGTH=6
VERIFICATION_EXPIRY_MINUTES=5
VERIFICATION_MAX_ATTEMPTS=3
# Server-side secret used to HMAC verification codes before storing them (min 32 chars).
# Generate the same way as INTERNAL_API_KEY. Changing it invalidates in-flight challenges only.
VERIFICATION_CODE_SECRET=

# Habbo API settings
HABBO_API_TIMEOUT_MS=10000
HABBO_API_MAX_RETRIES=2

# Logging (debug, info, warn, error)
LOG_LEVEL=info
