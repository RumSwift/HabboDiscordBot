# MariaDB
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
# Created on first start if it does not exist (needs CREATE permission)
DB_NAME=HabboVerifyBot

# Discord
DISCORD_TOKEN=
# Application ID
DISCORD_CLIENT_ID=

# Nicknames check sweep time is setting on
NICKNAME_SWEEP_INTERVAL_SECONDS=60

# Internal HTTP API
API_HOST=127.0.0.1
API_PORT=3000
# Generate with a key for this
INTERNAL_API_KEY=

# Admin page at http://API_HOST:API_PORT/admin/ for choosing servers, roles and log channels.
# Setpup commands better this is fallback - Don't set and the page wont show
ADMIN_PASSWORD=

# Verification settings
VERIFICATION_CODE_PREFIX=DISC-
VERIFICATION_CODE_LENGTH=6
VERIFICATION_EXPIRY_MINUTES=5
VERIFICATION_MAX_ATTEMPTS=3
# Generate the same way as INTERNAL_API_KEY
VERIFICATION_CODE_SECRET=

# Habbo API settings
HABBO_API_TIMEOUT_MS=10000
HABBO_API_MAX_RETRIES=2

# Logging (debug, info, warn, error)
LOG_LEVEL=info
